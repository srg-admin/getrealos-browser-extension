{
    "manifest_version": 3,
    "name": "Brumilo",
    "version": "1.0.0",
    "description": "Shows what each card charge was for in your Brumilo books, starting with your Amazon order history.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["scripting"],
    "host_permissions": ["https://www.amazon.com/*"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://app.brumilo.com/*",
                "https://app-dev.brumilo.com/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": ["bridge.js"],
            "run_at": "document_start"
        }
    ]
}
